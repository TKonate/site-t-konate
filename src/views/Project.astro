---
import { pages } from '../data/pages';
import { projects, type Project } from '../data/projects';
import { routes } from '../lib/routes';
import { getArt } from '../data/art';

/**
 * Project detail body, shared by /projets/<slug>/ and /en/projects/<slug>/.
 *
 * The Project object arrives as a prop from getStaticPaths, which reads the same
 * src/data/projects array used by the index: the page cannot describe a project
 * that the index does not list.
 *
 * "Next project" follows array order and wraps with a modulo, so the last project
 * points back at the first instead of ending the visit.
 *
 * Projects with a `media` array also render a figure block above the prose. Those
 * captures live in public/media and come from the public repository, with width
 * and height so the box is reserved before the image loads; a project without
 * media simply has no block.
 */
interface Props { project: Project; lang: 'fr' | 'en' }
const { project, lang } = Astro.props;
const p = pages[lang].project;
const idx = projects.findIndex((x) => x.slug === project.slug);
const next = projects[(idx + 1) % projects.length];
---
<article class="project-page">
  <header class="page-hero project-hero" data-reveal>
    <div class="wrap">
      <a class="back-link" href={routes.projects[lang]}>← {p.back}</a>
      <p class="kicker">{project.kind[lang]} · {project.year}</p>
      <h1 class="project-title">{project.name}</h1>
      <p class="page-lead">{project.pitch[lang]}</p>
      {project.url && (
        <p style="margin-top:22px">
          <a class="btn btn-primary" href={project.url} target="_blank" rel="noopener noreferrer">{p.repo} ↗</a>
        </p>
      )}
      {!project.url && project.source && (
        <p class="source-note">{project.source[lang]}</p>
      )}
    </div>
  </header>

  <div class="wrap project-body">
    <div class="project-main">
    {/* L'illustration décorative n'apparaît que s'il n'y a pas de visuel réel :
        deux images empilées sur la même page, c'est du bruit. */}
    {!project.media?.length && getArt(project.slug) && (
      <div class="art project-art" aria-hidden="true" set:html={getArt(project.slug)}></div>
    )}

    {project.media && project.media.length > 0 && (
      <section class="block media-block" data-reveal>
        {project.media.map((m) => (
          <figure class={`media-figure${m.tone === 'light' ? ' is-light' : ''}`}>
            <img src={m.src} alt={m.alt[lang]} width={m.width} height={m.height}
                 loading="lazy" decoding="async" />
            <figcaption>{m.caption[lang]}</figcaption>
          </figure>
        ))}
      </section>
    )}

    <section class="block" data-reveal>
      <h2>{p.problem}</h2>
      <p>{project.problem[lang]}</p>
    </section>

    <section class="block" data-reveal>
      <h2>{p.built}</h2>
      <p>{project.built[lang]}</p>
    </section>

    <section class="block" data-reveal>
      <h2>{p.highlights}</h2>
      <ul class="points">
        {project.highlights[lang].map((h) => <li>{h}</li>)}
      </ul>
    </section>

    <nav class="next-project" data-reveal>
      <span class="kicker">{p.next}</span>
      <a href={routes.project(next.slug)[lang]}>
        {next.name}
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </nav>
    </div>

    <aside class="project-rail" aria-label={project.name}>
      <dl class="facts">
        <div><dt>{p.railYear}</dt><dd>{project.year}</dd></div>
        <div><dt>{p.railKind}</dt><dd>{project.kind[lang]}</dd></div>
        <div><dt>{p.railStatus}</dt><dd>{project.status === 'wip' ? p.statusWip : p.statusPublic}</dd></div>
      </dl>
      <ul class="stack stack-rail">
        {project.stack.map((tech) => <li>{tech}</li>)}
      </ul>
    </aside>
  </div>
</article>
