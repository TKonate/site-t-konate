---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config';

interface Props {
  lang: 'fr' | 'en';
  title: string;
  description: string;
  /** Chemin de la même page dans l'autre langue. */
  altFr: string;
  altEn: string;
}
const { lang, title, description, altFr, altEn } = Astro.props;
const base = SITE.url.replace(/\/$/, '');
const canonical = base + Astro.url.pathname;
const frUrl = base + altFr;
const enUrl = base + altEn;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />
    <meta name="theme-color" content="#08090c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7f9" media="(prefers-color-scheme: light)" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.owner} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_GB' : 'fr_FR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: SITE.owner,
      url: base,
      email: SITE.email,
      jobTitle: lang === 'fr'
        ? 'Étudiant en informatique et électronique'
        : 'Computer science and electronics student',
      sameAs: [SITE.github, SITE.linkedin],
      knowsAbout: ['Python', 'TypeScript', 'Docker', 'Ollama', 'Linux', 'Cybersecurity'],
    })} />

    <script is:inline>
      // Thème : préférence enregistrée, sinon réglage du système. Exécuté avant peinture.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    <script is:inline>
      // Choix de langue : préférence explicite d'abord, langue du navigateur sinon.
      (function () {
        document.documentElement.classList.add('js');
        var lang = document.documentElement.lang;
        var stored = null;
        try { stored = localStorage.getItem('lang'); } catch (e) {}
        var frEl = document.querySelector('link[rel="alternate"][hreflang="fr"]');
        var enEl = document.querySelector('link[rel="alternate"][hreflang="en"]');
        var target = null;
        if (stored === 'en' && lang === 'fr' && enEl) target = enEl.href;
        else if (stored === 'fr' && lang === 'en' && frEl) target = frEl.href;
        else if (!stored && lang === 'fr' && enEl) {
          var list = navigator.languages && navigator.languages.length
            ? navigator.languages : [navigator.language || 'fr'];
          var primary = String(list[0] || 'fr').toLowerCase();
          if (primary.indexOf('fr') !== 0) target = enEl.href;
        }
        if (target) location.replace(new URL(target).pathname + new URL(target).search);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'fr' ? 'Aller au contenu principal' : 'Skip to main content'}</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Header lang={lang} altFr={altFr} altEn={altEn} />
    <main class="shell" id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script is:inline>
      // Barre de progression + en-tête compacté
      (function () {
        var header = document.querySelector('.header');
        var bar = document.querySelector('.scroll-progress');
        function onScroll() {
          var y = window.scrollY;
          header && header.setAttribute('data-scrolled', String(y > 8));
          if (bar) {
            var h = document.documentElement.scrollHeight - window.innerHeight;
            bar.style.width = (h > 0 ? (y / h) * 100 : 0) + '%';
          }
        }
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      })();

      // Apparition au scroll
      (function () {
        var items = document.querySelectorAll('[data-reveal]');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          items.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        items.forEach(function (el) { io.observe(el); });
      })();

      // Bascule de thème : auto -> clair -> sombre -> auto
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var label = btn.querySelector('[data-theme-label]');
        var media = window.matchMedia('(prefers-color-scheme: light)');
        var L = document.documentElement.lang === 'fr'
          ? { auto: 'automatique', light: 'clair', dark: 'sombre', action: 'Changer de thème', current: 'Thème actuel' }
          : { auto: 'automatic', light: 'light', dark: 'dark', action: 'Change theme', current: 'Current theme' };

        function stored() {
          try { return localStorage.getItem('theme'); } catch (e) { return null; }
        }
        function effective() {
          var s = stored();
          if (s === 'light' || s === 'dark') return s;
          return media.matches ? 'light' : 'dark';
        }
        function render() {
          var s = stored();
          var mode = s === 'light' || s === 'dark' ? s : 'auto';
          var text = L.current + ' : ' + L[mode] + ' — ' + L.action;
          btn.setAttribute('aria-label', text);
          btn.setAttribute('title', text);
          if (label) label.textContent = L[mode];
        }
        btn.addEventListener('click', function () {
          var order = ['auto', 'light', 'dark'];
          var s = stored();
          var mode = s === 'light' || s === 'dark' ? s : 'auto';
          var next = order[(order.indexOf(mode) + 1) % order.length];
          try {
            if (next === 'auto') localStorage.removeItem('theme');
            else localStorage.setItem('theme', next);
          } catch (e) {}
          if (next === 'auto') document.documentElement.removeAttribute('data-theme');
          else document.documentElement.setAttribute('data-theme', next);
          render();
        });
        media.addEventListener('change', render);
        render();
      })();

      // Mémoriser le choix de langue au clic
      (function () {
        document.querySelectorAll('[data-set-lang]').forEach(function (a) {
          a.addEventListener('click', function () {
            try { localStorage.setItem('lang', a.getAttribute('data-set-lang')); } catch (e) {}
          });
        });
      })();
    </script>
  </body>
</html>
