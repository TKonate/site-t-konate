---
import { SITE } from '../site.config';
import { copy } from '../data/copy';
import { projects } from '../data/projects';
import { personal } from '../data/personal';
import ContactForm from './ContactForm.astro';

interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = copy[lang];
const prefix = lang === 'fr' ? '/' : '/en/';
/** Mode portfolio (commercial: false) ou mode entreprise (true). */
const biz = SITE.commercial;
const p = personal[lang];
const hero = biz ? t.hero : p.hero;
const contactCopy = biz ? t.contact : { title: p.contact.title, intro: p.contact.intro };
const heroPrimaryHref = biz ? '#contact' : '#projets';
const heroSecondaryHref = biz ? '#projets' : '#contact';

const list = [...projects].sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)));
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-inner">
    <p class="kicker">{hero.kicker}</p>
    <h1>{hero.title}</h1>
    <p class="lead">{hero.lead}</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={`${prefix}${heroPrimaryHref}`}>{hero.ctaPrimary}</a>
      <a class="btn" href={`${prefix}${heroSecondaryHref}`}>{hero.ctaSecondary}</a>
    </div>
    <ul class="badges">
      {hero.badges.map((b) => <li>{b}</li>)}
    </ul>
    </div>

    <aside class="hero-panel" aria-label={t.heroPanel.title}>
      <p class="hero-panel-title">
        <span class="dot"></span>{t.heroPanel.title}
      </p>
      <dl>
        {t.heroPanel.rows.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </aside>
  </div>
</section>

{biz && (
<section class="section" id="studio">
  <div class="wrap">
    <div class="section-head">
      <p class="kicker">{t.nav.studio}</p>
      <h2>{t.services.title}</h2>
      <p>{t.services.intro}</p>
    </div>
    <div class="grid grid-3 services-grid">
      {
        t.services.items.map((item, i) => (
          <article class="card">
            <span class="card-index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <p class="card-tag">{item.tag}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
)}

<section class="section" id="projets">
  <div class="wrap">
    <div class="section-head">
      <p class="kicker">{t.nav.projects}</p>
      <h2>{t.projects.title}</h2>
      <p>{t.projects.intro}</p>
    </div>
    <div class="grid grid-2">
      {
        list.map((p) => (
          <article class="card project">
            <div class="project-top">
              <span class="project-name">{p.name}</span>
              <span class="project-year">{p.year}</span>
            </div>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
              <span class="project-kind">{p.kind[lang]}</span>
              {p.status === 'wip' && <span class="badge-wip">{t.projects.wip}</span>}
            </div>
            <p>{p.summary[lang]}</p>
            <ul class="stack">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>
            {p.url && (
              <a class="project-link" href={p.url} target="_blank" rel="noopener noreferrer">
                {t.projects.viewRepo}
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 17 17 7M17 7H9m8 0v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            )}
          </article>
        ))
      }
    </div>
    <p style="margin-top:26px">
      <a class="btn btn-sm" href={SITE.github} target="_blank" rel="noopener noreferrer">{t.projects.allRepos}</a>
    </p>
  </div>
</section>

{biz && (
<section class="section" id="methode">
  <div class="wrap">
    <div class="section-head">
      <p class="kicker">{t.nav.process}</p>
      <h2>{t.process.title}</h2>
      <p>{t.process.intro}</p>
    </div>
    <div class="steps">
      {
        t.process.steps.map((s) => (
          <article class="step">
            <span class="step-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
)}

<section class="section" id="a-propos">
  <div class="wrap about-grid">
    <div>
      <div class="section-head" style="margin-bottom:22px">
        <p class="kicker">{t.nav.about}</p>
        <h2>{t.about.title}</h2>
      </div>
      <div class="prose">
        {t.about.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <dl class="facts">
      {t.about.facts.map(([k, v]) => (
        <div><dt>{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
  </div>
</section>

<section class="section" id="contact">
  <div class="wrap contact-grid">
    <div>
      <div class="section-head" style="margin-bottom:22px">
        <p class="kicker">{t.nav.contact}</p>
        <h2>{contactCopy.title}</h2>
        <p>{contactCopy.intro}</p>
      </div>
      <div class="contact-direct">
        <span class="muted" style="font-family:var(--font-mono);font-size:.7rem;letter-spacing:.09em;text-transform:uppercase">
          {t.contact.direct}
        </span>
        <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <span class="muted" style="font-size:.88rem">{SITE.location[lang]}</span>
      </div>
      {biz && (
        <div class="availability">
          <span class="pill">{t.contact.availability.pill}</span>
          <p>{t.contact.availability.line}</p>
        </div>
      )}
      <div class="socials">
        <a href={SITE.github} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/>
          </svg>
          github.com/TKonate
        </a>
        <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.6c0-1.34-.02-3.06-1.9-3.06-1.9 0-2.2 1.45-2.2 2.96V21h-4V9Z"/>
          </svg>
          linkedin.com/in/tiberio-konate
        </a>
      </div>
    </div>
    <ContactForm lang={lang} />
  </div>
</section>
