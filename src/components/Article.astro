---
/**
 * Layout of a single article: meta line, title, lead, the rendered Markdown
 * through the default slot, and a back link.
 *
 * Presentation only. It receives strings that are already localised and a
 * `dateLabel` that the page formatted, because the locale of the date belongs to
 * the language of the route, not to this component.
 */
interface Props {
  title: string;
  lead: string;
  date: string;
  dateLabel: string;
  backHref: string;
  backLabel: string;
}
const { title, lead, date, dateLabel, backHref, backLabel } = Astro.props;
---
<article class="wrap article">
  <header class="article-head">
    <p class="article-meta">
      <time datetime={date}>{dateLabel}</time>
    </p>
    <h1>{title}</h1>
    <p class="article-lead">{lead}</p>
  </header>

  <div class="article-body">
    <slot />
  </div>

  <footer class="article-foot">
    <a href={backHref}>← {backLabel}</a>
  </footer>
</article>

<style>
  .article-head {
    max-width: 68ch;
    margin-block: 12px 34px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .article-meta {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute, #8b94a6);
  }
  .article-head h1 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.15;
  }
  .article-lead {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .article-body {
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: 18px;
    line-height: 1.7;
  }
  .article-body :global(h2) {
    margin-block: 26px 2px;
    font-size: 1.32rem;
    line-height: 1.3;
  }
  .article-body :global(h3) {
    margin-block: 18px 0;
    font-size: 1.08rem;
  }
  .article-body :global(p) {
    margin: 0;
    color: var(--ink-soft);
  }
  .article-body :global(strong) {
    color: var(--ink);
  }
  .article-body :global(code) {
    font-size: 0.9em;
    padding: 2px 5px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.06);
  }
  .article-body :global(pre) {
    margin: 0;
    overflow-x: auto;
    padding: 14px 16px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line, rgba(255, 255, 255, 0.08));
  }
  .article-body :global(pre code) {
    padding: 0;
    background: none;
    font-size: 0.85rem;
    line-height: 1.55;
  }
  .article-body :global(ul) {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--ink-soft);
  }
  .article-body :global(em) {
    color: var(--ink-soft);
  }
  .article-foot {
    max-width: 68ch;
    margin-top: 40px;
    padding-top: 18px;
    border-top: 1px solid var(--line, rgba(255, 255, 255, 0.08));
    font-size: 0.92rem;
  }
  .article-foot a {
    color: var(--accent, #7aa8ff);
    text-decoration: none;
  }
  .article-foot a:hover {
    text-decoration: underline;
  }
</style>
