---
import { SITE } from '../site.config';

interface Props { lang: 'fr' | 'en'; compact?: boolean }
const { lang, compact = false } = Astro.props;
const items = [
  {
    href: SITE.github,
    label: 'github.com/TKonate',
    name: 'GitHub',
    path: 'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z',
  },
  {
    href: SITE.linkedin,
    label: 'linkedin.com/in/tiberio-konate',
    name: 'LinkedIn',
    path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.6c0-1.34-.02-3.06-1.9-3.06-1.9 0-2.2 1.45-2.2 2.96V21h-4V9Z',
  },
  {
    href: `mailto:${SITE.email}`,
    label: SITE.email,
    name: lang === 'fr' ? 'Email' : 'Email',
    path: 'M3 5h18v14H3V5Zm2 2v.4l7 4.6 7-4.6V7H5Zm0 2.9V17h14V9.9l-6.5 4.2a1 1 0 0 1-1 0L5 9.9Z',
  },
];
---
<ul class="socials" class:list={[{ 'socials-compact': compact }]}>
  {items.map((i) => (
    <li>
      <a href={i.href} target={i.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={i.path}/></svg>
        <span>{compact ? i.name : i.label}</span>
      </a>
    </li>
  ))}
</ul>
