---
import { SITE, BRAND, TAGLINE } from '../site.config';
import { copy } from '../data/copy';

interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = copy[lang];
const prefix = lang === 'fr' ? '/' : '/en/';
const sections: Array<[string, string]> = [
  ['#studio', t.nav.studio],
  ['#projets', t.nav.projects],
  ['#methode', t.nav.process],
  ['#a-propos', t.nav.about],
];
// En mode portfolio, ni section Studio ni méthode : ce sont des arguments commerciaux.
const nav = SITE.commercial
  ? sections
  : sections.filter(([href]) => href !== '#studio' && href !== '#methode');
---
<header class="header">
  <div class="wrap header-inner">
    <a class="brand" href={prefix} aria-label={BRAND}>
      <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 1.6 13.9 9.1 21.4 11 13.9 12.9 12 20.4 10.1 12.9 2.6 11 10.1 9.1Z"
          fill="url(#g)"
        />
        <defs>
          <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#9dbdff"></stop>
            <stop offset="1" stop-color="#7aa8ff"></stop>
          </linearGradient>
        </defs>
      </svg>
      <span>{BRAND}</span>
      <span class="brand-sub">{TAGLINE[lang]}</span>
    </a>

    <nav class="nav" aria-label="Navigation">
      {nav.map(([href, label]) => <a href={`${prefix}${href}`}>{label}</a>)}
    </nav>

    <div class="header-actions">
      <div class="lang" role="group" aria-label="Language">
        <a href="/" aria-current={lang === 'fr' ? 'true' : 'false'}>FR</a>
        <a href="/en/" aria-current={lang === 'en' ? 'true' : 'false'}>EN</a>
      </div>
      <a class="btn btn-primary btn-sm" href={`${prefix}#contact`}>{lang === 'fr' ? 'Me contacter' : 'Get in touch'}</a>

    <details class="nav-mobile">
      <summary class="menu-btn" aria-label={lang === 'fr' ? 'Ouvrir le menu' : 'Open menu'}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </summary>
      <nav class="mobile-panel" aria-label="Navigation">
        {nav.map(([href, label]) => <a href={`${prefix}${href}`}>{label}</a>)}
        <a href={`${prefix}#contact`}>{lang === 'fr' ? 'Contact' : 'Contact'}</a>
      </nav>
    </details>
    </div>
  </div>
</header>
